# TeleVPS Pro - Environment Variables
# ---------------------------------------------------------

# 1. Telegram Credentials (REQUIRED)
# Get token from @BotFather
TELEGRAM_BOT_TOKEN="your_bot_token_here"
# Get ID from @userinfobot
TELEGRAM_ADMIN_ID="123456789"

# 2. GitHub Credentials (OPTIONAL - Can be set via Bot)
# Create PAT at https://github.com/settings/tokens
GITHUB_TOKEN=""

# 3. Webhook Configuration
# Port for the FastAPI server to listen on
WEBHOOK_PORT="8080"
# Secret for HMAC verification (Generated by setup.sh)
WEBHOOK_SECRET="random_hex_string"
# Your VPS Public IP or Domain (Auto-detected by setup.sh)
HOST_URL="your_vps_ip"

# 4. Storage Configuration
# Root directory where apps will be cloned
APPS_DIR="/var/www/apps"
